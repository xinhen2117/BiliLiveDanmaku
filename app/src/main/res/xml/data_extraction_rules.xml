<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Each mode allows only settings; no shared preferences or login cookies are transferred. -->
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
